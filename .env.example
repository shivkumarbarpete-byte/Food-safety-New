# ===============================================================
# FoodSafetyHub Multi-Container Environment Configuration
# ===============================================================

# 1. MongoDB Configuration
# For Docker Compose internal networking:
MONGO_URI=mongodb://database:27017/foodsafetyhub
# For standalone local run without Docker:
# MONGO_URI=mongodb://localhost:27017/foodsafetyhub
# For MongoDB Atlas Cloud:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/foodsafetyhub

# 2. Authentication & Security
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string_in_production

# 3. Node.js API Service Settings
PORT=5000
NODE_ENV=production

# 4. Machine Learning & Computer Vision Service URL
# Internal Docker bridge address:
PYTHON_ML_URL=http://ml-service:8000
# For local development outside Docker:
# PYTHON_ML_URL=http://localhost:8000

# 5. Frontend Port (Mapped in docker-compose.yml)
FRONTEND_PORT=3000
